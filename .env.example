# ─── Banco de dados (MySQL) ──────────────────────────────────
DB_ROOT_PASSWORD=troque_esta_senha
DB_NAME=nos_de_afeto
DB_USER=usuario
DB_PASSWORD=troque_esta_senha_tambem

# ─── Backend ─────────────────────────────────────────────────
BACKEND_PORT=3333
# Gere uma chave longa e aleatória. Alterá-la invalida todas as
# sessões ativas de uma vez.
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
JWT_EXPIRES_IN=7d
NODE_ENV=production
LOG_LEVEL=info

# Endereço público da aplicação, usado pelo Nginx e pelo front.
BASE_URL=https://meuapp.local

# ─── Frontend ────────────────────────────────────────────────
# Caminho relativo: o Nginx faz o proxy de /api para o backend.
FRONTEND_API_URL=/api