<?xml version="1.0" encoding="utf-8"?>
<!--
  Coloque este arquivo em:
      android/app/src/main/res/xml/network_security_config.xml

  E referencie no AndroidManifest.xml, dentro da tag <application>:
      android:networkSecurityConfig="@xml/network_security_config"

  Por padrão o Android bloqueia tráfego HTTP em texto puro.
  Aqui liberamos APENAS os endereços de desenvolvimento local
  (o alias do host no emulador e o localhost), mantendo o bloqueio
  para todo o resto — em produção a comunicação segue por HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Alias do host da máquina dentro do emulador Android -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Demais domínios continuam exigindo HTTPS -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
