# ─── Segredos ────────────────────────────────────────────────
# Credenciais do banco e JWT_SECRET. Nunca versionar.
.env
.env.local
.env.*.local
*.pem
*.key

# O exemplo SEM valores reais deve ser versionado:
!.env.example

# ─── Dependências ────────────────────────────────────────────
node_modules/
*/node_modules/
.npm
.yarn/

# ─── Builds ──────────────────────────────────────────────────
dist/
build/
*/dist/
*/build/
.seed-tmp/

# Frontend React
front-atelie-no-de-afeto/build/

# ─── Android (React Native) ──────────────────────────────────
mobile-atelie/android/build/
mobile-atelie/android/app/build/
mobile-atelie/android/.gradle/
mobile-atelie/android/.cxx/
mobile-atelie/android/app/.cxx/
mobile-atelie/android/local.properties
mobile-atelie/android/.idea/
mobile-atelie/android/app/src/main/assets/fonts/

# Chaves de assinatura — exceto a de depuração, que é pública
*.keystore
*.jks
!debug.keystore

# ─── iOS ─────────────────────────────────────────────────────
mobile-atelie/ios/Pods/
mobile-atelie/ios/build/
*.xcworkspace

# ─── Metro / React Native ────────────────────────────────────
.metro-health-check*
mobile-atelie/.expo/

# ─── Uploads em tempo de execução ────────────────────────────
# As imagens de referência do seed ficam versionadas; o que os
# usuários enviam, não.
back-atelie-no-de-afeto/uploads/*
!back-atelie-no-de-afeto/uploads/.gitkeep
!back-atelie-no-de-afeto/uploads/*.jpeg

# ─── Certificados TLS locais ─────────────────────────────────
# Gerados pelo mkcert em cada máquina; não fazem sentido no repo.
nginx/certs/

# ─── Testes ──────────────────────────────────────────────────
cypress/screenshots/
cypress/videos/
coverage/

# ─── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ─── Sistema operacional ─────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editores ────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# ─── Prisma ──────────────────────────────────────────────────
# O client é gerado; as migrations SIM devem ser versionadas.
back-atelie-no-de-afeto/node_modules/.prisma/